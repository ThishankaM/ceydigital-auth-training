{
  "name": "express-ts-template",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "test": "jest --setupFiles dotenv/config",
    "test:watch": "jest --watch --setupFiles dotenv/config",
    "start": "node build/bin/www.js",
    "dev": "npm run build:dev && npm run watch",
    "build": "npm run clean && npm run compile && npm run copy && npm run compress",
    "build:dev": "npm run clean && npm run compile:dev && npm run copy",
    "build:prod": "npm run clean && npm run compile:prod && npm run copy && npm run minify && npm run compress",
    "clean": "rimraf build",
    "compile": "tsc --build tsconfig.prod.json",
    "compile:dev": "tsc --build tsconfig.json",
    "compile:prod": "tsc --build tsconfig.prod.json",
    "copy": "npm run copy:assets && npm run copy:views && npm run copy:config && npm run copy:shared",
    "copy:assets": "npx cpx2 \"src/public/**\" build/public",
    "copy:views": "npx cpx2 \"src/views/**\" build/views",
    "copy:config": "npx cpx2 \".env\" build && npx cpx2 \"package.json\" build",
    "copy:shared": "npx cpx2 \"src/shared/postgresql-error-codes.json\" build/shared",
    "watch": "concurrently \"npm run watch:ts\" \"npm run watch:assets\"",
    "watch:ts": "tsc --build tsconfig.json --watch",
    "watch:assets": "npx cpx2 \"src/{public,views}/**\" build --watch",
    "compress": "echo 'Compression would be implemented here if needed'",
    "migrate": "node-pg-migrate --migrations-dir database",
    "migrate:up": "node-pg-migrate up --migrations-dir database",
    "migrate:down": "node-pg-migrate down --migrations-dir database",
    "migrate:create": "node-pg-migrate create --migrations-dir database"
  },
  "jestSonar": {
    "reportPath": "coverage",
    "reportFile": "test-reporter.xml",
    "indent": 4
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bluebird": "^3.7.2",
    "compression": "^1.7.4",
    "connect-pg-simple": "^9.0.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-sync": "^4.0.4",
    "debug": "^4.3.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "http-errors": "^2.0.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.11",
    "node-pg-migrate": "^7.6.1",
    "passport": "^0.7.0",
    "passport-google-oauth2": "^0.2.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.12.0",
    "pug": "^3.0.3",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.0",
    "uglify-js": "^3.19.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/fs-extra": "^11.0.4",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.12",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.1",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/pug": "^2.0.10",
    "@types/uglify-js": "^3.17.5",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "chokidar": "^3.6.0",
    "concurrently": "^9.1.2",
    "cpx2": "^8.0.0",
    "eslint": "^8.57.1",
    "fs-extra": "^11.2.0",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "ncp": "^2.0.0",
    "nodeman": "^1.1.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
