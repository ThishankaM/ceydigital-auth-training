doctype html
html(lang="en" v=release)
	head
		meta(charset='utf-8')
		title express-ts
		base(href='/')
		meta(name='viewport' content='width=device-width, initial-scale=1')

		meta(name='title' content="express-ts")
		meta(name='description' content="")

		meta(name="keywords" content="express-ts")
		meta(name='robots' content='index, follow')
		//- Open Graph / Facebook
		meta(property='og:type' content='website')
		meta(property='og:subdomain' content='')
		meta(property='og:title' content="express-ts")
		meta(property='og:description' content="")
		meta(property='og:image' content='')
		//- Twitter
		meta(property='twitter:card' content='summary_large_image')
		meta(property='twitter:subdomain' content='')
		meta(property='twitter:title' content="express-ts")
		meta(property='twitter:description' content="")
		meta(property='twitter:image' content='')

		link(rel='icon' type='image/x-icon' href='favicon.ico')

	body
		block content
